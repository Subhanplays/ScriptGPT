{
  "name": "scriptgpt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd api && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install:all": "cd api && npm install && cd ../client && npm install",
    "db:generate": "cd api && npx prisma generate",
    "db:migrate": "cd api && npx prisma migrate dev",
    "db:push": "cd api && npx prisma db push",
    "db:seed": "cd api && npx tsx src/utils/seed.ts",
    "db:studio": "cd api && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
