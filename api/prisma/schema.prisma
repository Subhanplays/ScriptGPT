generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AIProvider {
  SCRIPTGPT
  GEMINI
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  role          UserRole  @default(USER)
  avatar        String?
  geminiApiKey  String?
  geminiModel   String?   @default("gemini-2.5-flash-lite")
  dailyLimit    Int       @default(50)
  monthlyLimit  Int       @default(1000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations    Conversation[]
  usageLogs        UsageLog[]
  systemSettings   SystemSetting[] @relation("SettingsAuthor")
}

model Conversation {
  id            String             @id @default(uuid())
  title         String
  userId        String
  aiProvider    AIProvider         @default(SCRIPTGPT)
  model         String?
  status        ConversationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  role            String
  content         String
  aiProvider      AIProvider?
  model           String?
  tokenCount      Int?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id              String   @id @default(uuid())
  userId          String
  conversationId  String?
  aiProvider      AIProvider
  model           String?
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  requestType     String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLimit {
  id            String   @id @default(uuid())
  role          UserRole @unique
  dailyLimit    Int      @default(50)
  monthlyLimit  Int      @default(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  author User? @relation("SettingsAuthor", fields: [updatedBy], references: [id])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}
