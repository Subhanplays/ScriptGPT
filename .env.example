# ScriptGPT Environment Configuration

# PostgreSQL Database URL
# Local: postgresql://postgres:password@localhost:5432/scriptgpt?schema=public
# Neon/Supabase: postgresql://user:password@host/database?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriptgpt?schema=public"

# JWT Secret (auto-generated by install.sh, or create your own)
JWT_SECRET=your-secret-jwt-key-change-this

# Admin Gemini API Key (for ScriptGPT AI mode - built-in AI)
ADMIN_GEMINI_KEY=

# CORS Origin (frontend URL)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
